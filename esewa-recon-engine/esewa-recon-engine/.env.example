# Audit log destination. SQLite by default; point at a shared volume in prod.
RECON_AUDIT_DB=recon_audit.db

# Rows written per bucket sheet before visible truncation. Unset = write everything.
# Workbook serialisation dominates wall time on very large runs; 100000 is a
# sensible ceiling for a daily Ops workbook.
# RECON_SHEET_ROW_CAP=100000

RECON_LOG_LEVEL=INFO
