{
  "accounts": [
    {
      "name": "DishHome",
      "folder": "DishHome",
      "output_prefix": "DishHome",
      "left": {
        "label": "CNP",
        "file": "ConnectNPay",
        "header_row": 4,
        "key_col": "match_ref",
        "status_col": "status",
        "amount_col": "AMOUNT",
        "filters": [
          {"action": "equals", "column": "client", "value": "esewa nepal v3"},
          {"action": "not_prefix", "column": "request id", "prefix": "CNP_"},
          {"action": "non_empty", "column": "match_ref"}
        ],
        "transforms": [
          {"action": "extract_after_marker", "source": "request id", "target": "match_ref", "marker": "ESEWA"}
        ],
        "status_rules": {
          "groups": {"Success": ["success"], "Timeout": ["time out"], "Failure": ["topup failure", "txn reversed"], "Processing": ["processing"]},
          "default": "Failure"
        }
      },
      "right": {
        "label": "DishHome",
        "file": "DishHome",
        "header_row": 2,
        "key_col": "unique_id",
        "status_col": "status",
        "amount_col": "txnamount",
        "filters": [{"action": "not_in", "column": "status", "values": ["", "n/a", "na", "nan"]}],
        "status_rules": {
          "groups": {"Success": ["complete"], "Failure": ["failed", "failure"], "Timeout": ["processing", "pending"], "Ambiguous": ["ambiguous"]},
          "default": "Failure"
        }
      }
    },
    {
      "name": "Fonepay",
      "folder": "Fonepay",
      "output_prefix": "Fonepay",
      "left": {
        "label": "CNP",
        "file": "eSewa Fonepay",
        "header_row": 1,
        "key_col": "match_ref",
        "status_col": "status",
        "amount_col": "txnamount",
        "filters": [{"action": "not_in", "column": "status", "values": ["", "n/a", "na", "nan"]}],
        "transforms": [
          {"action": "strip_prefix", "source": "unique_id", "target": "match_ref", "prefix": "FP-"},
          {"action": "strip_prefix", "source": "match_ref", "target": "match_ref", "prefix": "FT-"}
        ],
        "status_rules": {
          "groups": {"Success": ["complete"], "Failure": ["failed", "failure"], "Timeout": ["processing", "pending"]},
          "default": "Failure"
        }
      },
      "right": {
        "label": "Fonepay",
        "file": "Fonepay",
        "header_row": 1,
        "key_col": "retrieval_reference_number",
        "status_col": "credit_status",
        "amount_col": "original_transaction_amount",
        "filters": [{"action": "equals", "column": "credit_status", "value": "success"}],
        "status_rules": {"success_values": ["success"], "default": "Failure"}
      }
    },
    {
      "name": "NEA",
      "folder": "NEA",
      "output_prefix": "NEA",
      "left": {
        "label": "CNP",
        "file": "ConnectNPay",
        "header_row": 4,
        "key_col": "vendor trans id",
        "status_col": "status",
        "amount_col": "AMOUNT",
        "status_rules": {
          "groups": {"Success": ["success"], "Timeout": ["time out"], "Failure": ["topup failure", "txn reversed"], "Processing": ["processing"]},
          "default": "Failure"
        }
      },
      "right": {
        "label": "NEA",
        "file": "NEA",
        "header_row": 1,
        "key_col": "partner txn id",
        "amount_col": "paid_amt",
        "filters": [{"action": "regex", "column": "paid_date", "pattern": "^\\d{4}-\\d{2}-\\d{2}"}],
        "transforms": [{"action": "clean_spaces", "column": "partner txn id"}]
      }
    },
